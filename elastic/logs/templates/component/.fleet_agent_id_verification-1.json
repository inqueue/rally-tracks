{% import "rally.helpers" as rally %}
{
  "name": ".fleet_agent_id_verification-1",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          {%- if disable_pipelines is not true %}
          {%- if use_ingest_timestamps %}
          "final_pipeline": "track-custom-pipeline"
          {%- else %}
          "final_pipeline": ".fleet_final_pipeline-1"
          {%- endif %}
          {%- endif %}
        }
      },
      "mappings": {
        "properties": {
          "event": {
            "properties": {
              "agent_id_status": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "ingested": {
                "format": "strict_date_time_no_millis||strict_date_optional_time||epoch_millis",
                "type": "date"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "managed_by": "fleet",
      "managed": true
    }
  }
}